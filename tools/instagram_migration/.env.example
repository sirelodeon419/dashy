# Instagram Save Migration configuration
# Copy to .env and fill in as needed

# --- AI Providers ---
# One of these must be set depending on the chosen provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Instagram access (optional, recommended for private posts) ---
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- Networking ---
# Default timeout (seconds) for HTTP requests when fetching images
REQUEST_TIMEOUT=15
